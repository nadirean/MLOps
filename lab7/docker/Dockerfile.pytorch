FROM python:3.10-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

# Install C++ compiler for torch.compile and OpenMP
RUN apt-get update && apt-get install -y g++ libgomp1 && rm -rf /var/lib/apt/lists/*

# Install minimal PyTorch (CPU only) and other dependencies
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir transformers fastapi uvicorn

COPY app_pytorch.py /app/

CMD ["uvicorn", "app_pytorch:app", "--host", "0.0.0.0", "--port", "8000"]
